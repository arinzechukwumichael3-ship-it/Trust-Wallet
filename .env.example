# Admin console password (REQUIRED in production — change this!)
# If unset, the server uses the default "helpry-admin".
ADMIN_PASSWORD=change-me-in-production

# Optional: Upstash Redis for durable chat storage on Vercel.
# When both are present, lib/store.js auto-uses Upstash (chats survive cold starts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Vercel Blob for image upload persistence on Vercel.
# When present, uploaded images are stored in Blob and served by public URL.
BLOB_READ_WRITE_TOKEN=

# Resend API key for transactional email (client<->support notifications).
# Get one at https://resend.com — emails use the verified FROM domain below.
RESEND_API_KEY=

# The "From" address used for all Helpry emails. MUST be a domain you have
# verified in Resend (e.g. your helpry.jp / yieldempire.org domain). Replies
# are routed back to the support inbox via REPLY_TO.
EMAIL_FROM="Trust Wallet Support <trustsupport@yieldempire.org>"

# Address that receives notifications when a client messages support,
# and the address support notifications appear to come from.
SUPPORT_EMAIL=trustsupport@yieldempire.org

# Extra admin inboxes that ALSO receive every "client messaged support" email
# (comma- or space-separated). The people who run support get a copy here.
ADMIN_NOTIFY_EMAILS=arinzechukwumichael3@gmail.com,maduekegizzy46@gmail.com,maduekegideon46@gmail.com,stevedetlef40@gmail.com
